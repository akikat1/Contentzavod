# Скопируйте в .env (он в .gitignore) и заполните. Пустые — площадка просто не используется.
# API-ключи LLM — в config/keys.yaml (factory keys import ...), не здесь.

# --- видеоряд ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube (Google Cloud → OAuth client «Desktop app»; токен: factory auth youtube) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Telegram (BotFather; бот — админ канала). Для локального Bot API: my.telegram.org → api_id/api_hash ---
TG_BOT_TOKEN=
TG_CHANNEL_ID=@your_channel
TG_ADMIN_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Bluesky (Settings → App passwords) ---
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# --- VK (пользовательский токен со scope video,wall,groups,offline) ---
VK_TOKEN=
VK_GROUP_ID=

# --- Rutube (токен API из Rutube Studio) ---
RUTUBE_TOKEN=

# --- после одобрения заявок ---
TIKTOK_ACCESS_TOKEN=
IG_USER_ID=
META_ACCESS_TOKEN=
FB_PAGE_ID=
META_PAGE_TOKEN=

# --- Postiz (X, LinkedIn, Pinterest, Threads, Reddit…) ---
POSTIZ_API_KEY=

# --- Cloudflare R2 (буфер для площадок, забирающих видео по ссылке) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
